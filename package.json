    "infra:hetzner:deploy": "tsx infra/hetzner/deploy.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "better-auth": "1.6.0",
    "zod": "^4.6.5"
  }
}
