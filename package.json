{
  "name": "gsw-mail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/api & npm run dev --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "infra:hetzner:check": "tsx infra/hetzner/check.ts",
    "infra:hetzner:provision": "tsx infra/hetzner/provision.ts",
