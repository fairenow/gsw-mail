{
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/settings/mcp-mailbox-recovery",
      "destination": "/index.html"
    },
    {
      "source": "/integrations/:path*",
      "destination": "https://gsw-mail-production.up.railway.app/integrations/:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "https://gsw-mail-production.up.railway.app/.well-known/oauth-protected-resource/:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://gsw-mail-production.up.railway.app/.well-known/oauth-protected-resource"
    },
    {
      "source": "/support",
      "destination": "/index.html"
    },
    {
      "source": "/mail",
      "destination": "/index.html"
    },
    {
      "source": "/sign-in",
      "destination": "/index.html"
    },
    {
      "source": "/oauth/select-account",
      "destination": "/index.html"
    },
    {
      "source": "/oauth/consent",
      "destination": "/index.html"
    },
    {
      "source": "/oauth/test",
      "destination": "/index.html"
    },
    {
      "source": "/oauth/test/callback",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/account-deleted",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://gsw-mail-production.up.railway.app/api/:path*"
    },
    {
      "source": "/mail/:path*",
      "destination": "https://gsw-mail-production.up.railway.app/mail/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://gsw-mail-production.up.railway.app/admin/:path*"
    },
    {
      "source": "/product/:path*",
      "destination": "https://gsw-mail-production.up.railway.app/product/:path*"
    },
    {
      "source": "/health",
      "destination": "https://gsw-mail-production.up.railway.app/health"
    },
    {
      "source": "/auth/exchange",
      "destination": "https://gsw-mail-production.up.railway.app/auth/exchange"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/sign-up",
      "destination": "/index.html"
    },
    {
      "source": "/create-password",
      "destination": "/index.html"
    },
    {
      "source": "/setup",
      "destination": "/index.html"
    },
    {
      "source": "/control-center",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/contacts",
      "destination": "/index.html"
    },
    {
      "source": "/calendar",
      "destination": "/index.html"
    },
    {
      "source": "/calendar/rsvp",
      "destination": "/index.html"
    },
    {
      "source": "/public/avatars/:path*",
      "destination": "https://gsw-mail-production.up.railway.app/public/avatars/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
