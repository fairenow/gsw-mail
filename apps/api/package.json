{
  "name": "@gsw-mail/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/config.test.ts \"src/engine/*.test.ts\" \"src/lib/*.test.ts\" \"src/outbound/*.test.ts\" \"src/auth/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:seed:prod": "tsx --env-file-if-exists=.env src/db/prod-seed.ts",
    "db:backfill:prod": "tsx --env-file-if-exists=.env src/db/prod-backfill.ts",
    "db:normalize:workspace": "tsx --env-file-if-exists=.env src/db/normalize-workspace.ts",
    "db:change-control-email": "tsx --env-file-if-exists=.env src/db/change-control-email.ts",
    "auth:ensure-stalwart-client": "tsx --env-file-if-exists=.env src/auth/ensureStalwartClient.ts",
    "test:integration": "node --import tsx --test src/integration.test.ts",
    "build": "tsc --noEmit false --outDir dist --rootDir src --project tsconfig.build.json",
    "start": "node dist/index.js",
    "test:acceptance": "node --import tsx --test --test-name-pattern=\"mailbox isolation|delegate access|read_only|two-user acceptance\" src/integration.test.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.6.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@opentelemetry/api": "^1.9.0",
    "better-auth": "1.6.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.13.1",
    "resend": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
