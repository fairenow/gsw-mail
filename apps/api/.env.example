NODE_ENV=development

PORT=4000
DATABASE_URL=postgres://gsw_mail:change-me-postgres@localhost:5432/gsw_mail

MAIL_ENGINE=demo
STALWART_JMAP_URL=https://mx1.guidedstepswellness.com/jmap
STALWART_ADMIN_TOKEN=change-me-stalwart-admin
# Server credential for Stalwart token introspection and background recovery jobs.
# Normal request mailbox operations use the caller's OAuth bearer token.
STALWART_MAIL_USERNAME=ramon@team.guidedstepswellness.com
STALWART_MAIL_PASSWORD=change-me-mailbox-password
# Dedicated Stalwart account with the `impersonate` permission. The webhook worker
# authenticates as <target-mailbox>%<service-account> so it can resolve the actual
# JMAP Email id, subject, sender display name, and preview before sending a push.
STALWART_PUSH_JMAP_USERNAME=push-notifications@team.guidedstepswellness.com
STALWART_PUSH_JMAP_PASSWORD=change-me-push-service-password

OUTBOUND_RELAY=null
RESEND_API_KEY=
DELIVERY_WEBHOOK_SECRET=

# Better Auth owns user-facing signup, verification, password, magic-link, and sessions.
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_TRUSTED_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=change-me-better-auth-secret
AUTH_EMAIL_FROM=GSW <no-reply@localhost>

# Send / undo
SEND_DELAY_SECONDS=5
MAX_RECIPIENTS=50
SEND_PER_MINUTE=30
SEND_PER_HOUR=400

# Development-only identity fallback (refused in production)
DEV_USER_ID=ramon-dev

# Private file storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PRESIGN_TTL_SECONDS=900
FILES_FREE_QUOTA_BYTES=524288000
FILES_MAX_UPLOAD_BYTES=524288000

# AI provider routing
# User-facing aliases: qwen | gpt-oss-120b | openai | claude
# Internal provider ids also accepted: hetzner | huggingface | openai | anthropic
AI_PROVIDER=qwen
AI_TIMEOUT_MS=45000

# Hetzner Inference (current default)
HETZNER_INFERENCE_KEY=
HETZNER_INFERENCE_BASE_URL=https://inference.hetzner.com/api/v1
HETZNER_INFERENCE_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Optional specialized models used by GSW Files intelligence/artifact creation.
OPENAI_FILE_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_ARTIFACT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Hugging Face Inference Providers
# Either HF_TOKEN or HUGGINGFACE_API_TOKEN may be used.
HF_TOKEN=
HUGGINGFACE_CHAT_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_CHAT_MODEL=openai/gpt-oss-120b:fastest
# Ordered direct HF image fallbacks. Qwen-Image-2.1 is not provider-served yet;
# Qwen/Qwen-Image is attempted first, then a known hf-inference fallback.
HUGGINGFACE_IMAGE_MODELS=Qwen/Qwen-Image,stabilityai/stable-diffusion-3-medium-diffusers
HUGGINGFACE_IMAGE_BASE_URL=https://router.huggingface.co/hf-inference/models
# Optional dedicated Hugging Face Inference Endpoint for Qwen-Image-2.1 or another image model.
HUGGINGFACE_IMAGE_ENDPOINT_URL=

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=
