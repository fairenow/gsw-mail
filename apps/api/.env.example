NODE_ENV=development

PORT=4000
DATABASE_URL=postgres://gsw_mail:change-me-postgres@localhost:5432/gsw_mail

MAIL_ENGINE=demo
STALWART_JMAP_URL=https://mx1.guidedstepswellness.com/jmap
STALWART_ADMIN_TOKEN=change-me-stalwart-admin
# Mailbox service account (Basic auth) for JMAP mailbox operations
STALWART_MAIL_USERNAME=test@team.guidedstepswellness.com
STALWART_MAIL_PASSWORD=change-me-mailbox-password

OUTBOUND_RELAY=null
RESEND_API_KEY=
DELIVERY_WEBHOOK_SECRET=

# Identity (Stalwart OAuth bearer tokens; PKCE public client + confidential introspection client)
OIDC_ISSUER=https://mx1.guidedstepswellness.com
OIDC_CLIENT_ID=gsw-mail-web
OIDC_INTROSPECTION_CLIENT_ID=gsw-mail-api
OIDC_INTROSPECTION_CLIENT_SECRET=
IDENTITY_PROVIDER=stalwart

# Send / undo
SEND_DELAY_SECONDS=5
MAX_RECIPIENTS=50
SEND_PER_MINUTE=30
SEND_PER_HOUR=400

# Development-only identity fallback (refused in production)
DEV_USER_ID=ramon-dev