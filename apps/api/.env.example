NODE_ENV=development

PORT=4000
DATABASE_URL=postgres://gsw_mail:change-me-postgres@localhost:5432/gsw_mail

MAIL_ENGINE=demo
STALWART_JMAP_URL=https://mx1.guidedstepswellness.com/jmap
STALWART_ADMIN_TOKEN=change-me-stalwart-admin
# Server credential for Stalwart token introspection and background recovery jobs.
# Normal request mailbox operations use the caller's OAuth bearer token.
STALWART_MAIL_USERNAME=ramon@team.guidedstepswellness.com
STALWART_MAIL_PASSWORD=change-me-mailbox-password

OUTBOUND_RELAY=null
RESEND_API_KEY=
DELIVERY_WEBHOOK_SECRET=

# Better Auth owns user-facing signup, verification, password, magic-link, and sessions.
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_TRUSTED_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=change-me-better-auth-secret
AUTH_EMAIL_FROM=GSW <no-reply@localhost>

# Send / undo
SEND_DELAY_SECONDS=5
MAX_RECIPIENTS=50
SEND_PER_MINUTE=30
SEND_PER_HOUR=400

# Development-only identity fallback (refused in production)
DEV_USER_ID=ramon-dev
